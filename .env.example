# ====================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO HỆ THỐNG MEP PAYMENT AI (ONEAI INTEGRATION)
# Tạo file .env và điền các giá trị thực tế tương ứng trên máy chủ / máy làm việc
# ====================================================================

# 1. TÀI KHOẢN DATABASE YMS / ORACLE NỀN TẢNG
DB_USER_YMS=USER_YMS_THUC_TE
DB_PASSWORD_YMS=PASS_YMS_THUC_TE
TNS_YMS=MBAYMS

# 2. TÀI KHOẢN LOCAL AI (DÀNH CHO BẢNG LOCAL_AI.MEP_PAYMENT_ANALYSIS)
# Có thể dùng cùng tài khoản với YMS hoặc tài khoản AI riêng
DB_USER_YMS_AI=LOCAL_AI
DB_PASSWORD_YMS_AI=MAT_KHAU_LOCAL_AI

# 3. TÊN SERVICE / TNS ALIAS CƠ SỞ DỮ LIỆU
DB_SERVICE=MBAYMS

# 4. ĐƯỜNG DẪN THƯ MỤC ORACLE INSTANT CLIENT (THICK CLIENT)
# Windows: C:\instantclient_19_19 (hoặc thư mục client trên máy công ty)
# Linux / Docker: /opt/oracle/instantclient_19_19
ORACLE_CLIENT_LIB_DIR=C:\instantclient_19_19

# 5. CẤU HÌNH HOST/PORT DỰ PHÒNG (NẾU KHÔNG DÙNG TNSNAMES.ORA)
# DB_HOST=107.126.xx.xx
# DB_PORT=1521

# 6. CẤU HÌNH FASTAPI WORKER SERVICE
WORKER_HOST=0.0.0.0
WORKER_PORT=8000

