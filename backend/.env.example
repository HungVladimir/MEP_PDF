# AI model server
ONEAI_LLM__ENDPOINT=
ONEAI_LLM__API_KEY__MEP_PAYMENT=
ONEAI_LLM__MODEL_NAME=NextAI-SDV

# Oracle MBLDB / LOCAL_AI
DB_MBLDB_LOCAL_AI__PASSWORD=

# Địa chỉ và cổng của FastAPI khi chạy worker trực tiếp
WORKER_HOST=0.0.0.0
WORKER_PORT=8000
MAX_UPLOAD_SIZE_MB=50
# Optional root directory for private storage
# COMPANY_PRIVATE_ROOT=

# MinIO (enable and fill in the connection settings when needed)
USE_MINIO=false
ONEAI_MINIO__ENDPOINT=
ONEAI_MINIO__ACCESS=
ONEAI_MINIO__SECRET=
ONEAI_MINIO_BUCKETNAME=oneai
ONEAI_MINIO__SECURE=false
MINIO_PREFIX=mep_payment

# true restricts MEP writes and reviews to the configured users or roles
# false grants these permissions to anyone who can reach the API
MEP_ENABLE_AUTH=true
MEP_ADMIN_USERS=
MEP_ADMIN_ROLES=ADMIN,MANAGER,MEP_ADMIN,LEADER
