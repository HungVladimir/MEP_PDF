# 2. TÀI KHOẢN LOCAL AI (DÀNH CHO BẢNG LOCAL_AI.MEP_PAYMENT_ANALYSIS)
# Quy tắc đặt tên biến mật khẩu đồng bộ K8s & Local (Chu Đức Hải):
# Cú pháp: DB_[tên database]_[userName]__[mật khẩu] -> Bắt buộc 2 dấu gạch dưới '__'
# User được khai báo trực tiếp dạng string trong code: user_name="LOCAL_AI"
DB_MBLDB_LOCAL_AI__PASSWORD=WKEHDGHK1!
# Giữ thêm biến dự phòng tương thích ngược (1 gạch dưới):
DB_MBLDB_LOCAL_AI_PASSWORD=WKEHDGHK1!

# 3. TÊN SERVICE / TNS ALIAS CƠ SỞ DỮ LIỆU
DB_SERVICE=MBLDB_SVC

# 4. ĐƯỜNG DẪN THƯ MỤC ORACLE INSTANT CLIENT (THICK CLIENT)
ORACLE_CLIENT_LIB_DIR=C:\oracle_client

# 5. CẤU HÌNH HOST/PORT DỰ PHÒNG (NẾU KHÔNG DÙNG TNSNAMES.ORA)
# DB_HOST=107.126.xx.xx
# DB_PORT=1521

# 6. CẤU HÌNH FASTAPI WORKER SERVICE
WORKER_HOST=0.0.0.0
WORKER_PORT=8000

# 7. CẤU HÌNH MINIO OBJECT STORAGE (CHUẨN ONEAI PLATFORM: ONEAI_MINIO_*)
