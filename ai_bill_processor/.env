# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DÀNH RIÊNG CHO MODULE AI BILL PROCESSOR
# File: MEP_OneAI_System/ai_bill_processor/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ĐƯỜNG DẪN THƯ MỤC PRIVATE CHỨA 2 FILE EXCEL THỰC TẾ TRÊN MÁY BẠN
# (Điền đường dẫn thư mục private chứa 2 file Excel, code sẽ tự nhận diện cả 2 file)
# Ví dụ: D:/MyPrivateFiles/ThanhToan_AI_2026_10
# ------------------------------------------------------------------------------
AI_BILL_PRIVATE_DIR=

# (Tùy chọn) Nếu 2 file nằm ở 2 nơi khác nhau, bạn có thể điền thẳng đường dẫn từng file:
# AI_BILL_FILE1=D:/MyPrivateFiles/(AI Crew) thanh toán hóa đơn tháng 2026.10.xlsx
# AI_BILL_FILE2=D:/MyPrivateFiles/Chi tiết thanh toán 2026.10.xlsx


# ------------------------------------------------------------------------------
# 2. CẤU HÌNH DATABASE ORACLE (MBLDB)
# Tuân thủ quy tắc đồng bộ K8s & Local của team (Chu Đức Hải):
# Cú pháp: DB_[tên database]_[userName]__[mật khẩu] -> 2 dấu gạch dưới '__'
# ------------------------------------------------------------------------------
DB_DNS=MBLDB
DB_USER=LOCAL_AI
DB_MBLDB_LOCAL_AI__PASSWORD=WKEHDGHK1!

# Đường dẫn thư mục Oracle Instant Client (Thick Client)
ORACLE_CLIENT_LIB_DIR=C:\oracle_client


# ------------------------------------------------------------------------------
# 3. CẤU HÌNH MINIO OBJECT STORAGE (ONEAI PLATFORM)
# ------------------------------------------------------------------------------
ONEAI_MINIO_ENDPOINT=
ONEAI_MINIO_ACCESS=
ONEAI_MINIO_SECRET=
ONEAI_MINIO_BUCKETNAME=oneai

